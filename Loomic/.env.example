# ══════════════════════════════════════════════════════════════════════
# Helstera Environment Variables
# ══════════════════════════════════════════════════════════════════════
# Copy to .env.local (local dev) or .env.cloud (cloud deploy).
# Values marked [required] must be set; others have sensible defaults.

# ── Server ─────────────────────────────────────────────────────────
HELSTERA_SERVER_PORT=3001
HELSTERA_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SERVER_BASE_URL=http://localhost:3001        # cloud: https://your-api.up.railway.app

# ── Supabase (required) ───────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co        # [required]
SUPABASE_ANON_KEY=your-anon-key                          # [required]
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key           # [required] server-only, never expose
SUPABASE_DB_URL='postgresql://postgres:<pw>@host:port/postgres'  # [required] for PGMQ worker queue
SUPABASE_PROJECT_ID=your-project-ref                     # [required] for JWT verification
SUPABASE_JWT_SECRET={"x":"...","y":"...","alg":"ES256","crv":"P-256","kty":"EC","key_ops":["verify"]}

# Supabase browser-safe (NEXT_PUBLIC_ prefix exposes to frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Agent LLM ─────────────────────────────────────────────────────
HELSTERA_AGENT_BACKEND_MODE=state                          # "state" (default) or "filesystem"
HELSTERA_AGENT_MODEL=google:gemini-3-flash-preview         # format: <provider>:<model-id>
# Provider "openai" → needs OPENAI_API_KEY (+ optional OPENAI_API_BASE for proxy)
# Provider "google" → needs GOOGLE_API_KEY
OPENAI_API_KEY=                                          # optional, for openai provider
OPENAI_API_BASE=                                         # optional, custom endpoint / proxy
GOOGLE_API_KEY=                                          # optional, for google provider + Veo video + Imagen image

# ── Image / Video Generation ─────────────────────────────────────
REPLICATE_API_TOKEN=                                     # optional, enables 13 Replicate video/image models
METASO_API_KEY=                                          # optional, enables MiniMax H3 video via Metaso
METASO_API_BASE=https://metaso.cn/api/minimax/           # optional, Metaso H3 V2 base URL override
# GOOGLE_API_KEY above also enables Google Veo 3.1 video + Imagen image (Developer API)

# ── Google Vertex AI (optional, coexists with Developer API) ────
# Uses GCP service account for auth. Both Developer API and Vertex AI
# can be configured simultaneously — they register as separate providers.
GOOGLE_APPLICATION_CREDENTIALS=                          # path to service account JSON (e.g., ./credentials/vertex-ai-sa.json)
GOOGLE_VERTEX_PROJECT=                                   # GCP project ID (e.g., my-project-123456)
GOOGLE_VERTEX_LOCATION=                                  # GCP region (e.g., us-central1)

# ── Skills & Sandbox ─────────────────────────────────────────────
# Local dev: relative from apps/server/ cwd → ../../skills
# Docker/Railway: /opt/helstera/skills (Dockerfile copies skills/ there)
HELSTERA_SKILLS_ROOT=../../skills

# ── Worker (optional, defaults shown) ────────────────────────────
# WORKER_CODE_CONCURRENCY=3
# WORKER_IMAGE_CONCURRENCY=3
# WORKER_VIDEO_CONCURRENCY=2
# WORKER_POLL_INTERVAL_MS=2000

# ── Payment: Lemon Squeezy (international) ────────────────
LEMON_SQUEEZY_STORE=                                       # optional, e.g., helstera.com
LEMON_SQUEEZY_API_KEY=                                     # [required] server-only
LEMON_SQUEEZY_WEBHOOK_SECRET=                              # [required] for /api/payments/webhook signature
LEMON_SQUEEZY_VARIANT_STARTER_MONTHLY=                     # [required] e.g., variant UUID
LEMON_SQUEEZY_VARIANT_STARTER_YEARLY=
LEMON_SQUEEZY_VARIANT_PRO_MONTHLY=
LEMON_SQUEEZY_VARIANT_PRO_YEARLY=
LEMON_SQUEEZY_VARIANT_ULTRA_MONTHLY=
LEMON_SQUEEZY_VARIANT_ULTRA_YEARLY=
LEMON_SQUEEZY_VARIANT_BUSINESS_MONTHLY=
LEMON_SQUEEZY_VARIANT_BUSINESS_YEARLY=

# ── Payment: YeePay (易支付 - China market) ────────────────
# YeePay Native/QR scan pay for Chinese users (CNY ¥)
# Docs: https://open.yeepay.com/docs/products/pay-api/native-pay
YEEPAY_MERCHANT_ID=                                       # [required] 商户号
YEEPAY_APP_KEY=                                            # [required] 应用 Key
YEEPAY_APP_SECRET=                                         # [required] 应用 Secret (HMAC)
YEEPAY_BASE_URL=https://api.yeepay.com                     # API base URL
YEEPAY_WEBHOOK_SECRET=                                     # [required] 异步通知验签密钥
YEEPAY_NOTIFY_URL=                                         # default: ${HELSTERA_WEB_ORIGIN}/api/yeepay/webhook

# ── Top-up: Lemon Squeezy variant ids (international, USD) ────
# Each topup package maps to a Lemon Squeezy variant. Get these from your
# Lemon Squeezy dashboard → Products → Variants.
# When unset, the package is unavailable for international checkout.
LEMON_SQUEEZY_TOPUP_VARIANT_STARTER_PACK=                # e.g. "12345"
LEMON_SQUEEZY_TOPUP_VARIANT_STANDARD_PACK=
LEMON_SQUEEZY_TOPUP_VARIANT_PRO_PACK=
LEMON_SQUEEZY_TOPUP_VARIANT_BUSINESS_PACK=

# ── Misc ─────────────────────────────────────────────────────────
GOOGLE_FONTS_API_KEY=                                    # optional, brand kit font picker
# VOLCES_API_KEY=                                        # optional, TTS
# VOLCES_BASE_URL=                                       # optional, TTS

# ── Local dev only ───────────────────────────────────────────────
# GLOBAL_AGENT_HTTP_PROXY=http://127.0.0.1:7890          # HTTP proxy for outbound requests

# Project-owned magic-link email SMTP
MAIL_HOST=mail.helstera.com
MAIL_PORT=465
MAIL_USER=your-mailbox
MAIL_PASSWORD=your-password
MAIL_FROM=Helstera <no-reply@helstera.com>
