{
  "name": "@helstera/desktop",
  "version": "0.2.4",
  "private": true,
  "description": "Helstera Desktop — AI Design Studio",
  "author": "Helstera",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.electron.json && vite build && electron-builder",
