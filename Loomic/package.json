{
  "name": "helstera",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "test:workspace": "node --test tests/workspace.test.mjs",
    "test:packages": "turbo run test",
    "test": "pnpm run test:workspace && pnpm run test:packages",
    "seed": "node scripts/seed-test-accounts.mjs",
    "typecheck": "turbo run typecheck",
    "deploy:sync-shared": "node scripts/deploy/sync-shared-dist.mjs",
    "video:prepare": "node scripts/prepare-creative-sources.mjs video && node scripts/prepare-creative-sources.mjs onetake",
    "video:build": "bun scripts/build-visualforge-runtime.ts",
    "test:visualforge": "bun scripts/test-visualforge.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "global-agent": "^4.1.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
